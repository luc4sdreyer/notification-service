{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Small in-memory notification service (take-home assignment)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "openapi-typescript openapi.yaml -o src/generated/api.d.ts",
    "audit": "pnpm audit"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
